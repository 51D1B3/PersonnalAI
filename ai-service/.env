# ==========================================
# PersonalAI - Configuration Service IA
# ==========================================

# Port du microservice IA autonome
AI_SERVICE_PORT=5000

# URL de l'instance locale Ollama
OLLAMA_URL=http://localhost:11434

# Modèle d'embeddings sémantiques (recommandé: nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text

# Modèle de génération de texte / RAG (recommandé: llama3 ou qwen2.5:1.5b ou mistral)
LLM_MODEL=llama3

# Dimensions du vecteur d'embeddings (1536 par défaut pour pgvector Supabase)
EMBEDDING_DIMENSIONS=1536
